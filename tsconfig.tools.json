{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "outDir": "./node_modules/.cache/tsc-tools",
    "tsBuildInfoFile": "./node_modules/.cache/tsc-tools/tsbuildinfo"
  },
  "include": ["scripts/*.ts", "apps/*/vite.config.ts", "apps/*/vitest.config.ts", "packages/*/vitest.config.ts"],
  "references": [{ "path": "packages/shared" }, { "path": "packages/core" }]
}
